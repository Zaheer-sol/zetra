# ───────────────────────────── Runtime ─────────────────────────────
NODE_ENV=development

# Origin of the web console. Used for CORS/CSRF checks and cookie scoping.
WEB_ORIGIN=http://localhost:3000
# Public base URL used in hosted payment links (defaults to WEB_ORIGIN).
PUBLIC_APP_URL=http://localhost:3000
API_PORT=4000
# Where the Next.js server proxies /api/* (server-side only, never exposed to the browser).
API_INTERNAL_URL=http://localhost:4000
LOG_LEVEL=info

# ───────────────────────────── Database ─────────────────────────────
# The application connects as zetra_app, a NON-superuser role, so row-level security is enforced.
DATABASE_URL=postgresql://zetra_app:zetra_app@localhost:5432/zetra
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=postgresql://zetra:zetra@localhost:5432/zetra
# Integration tests use a separate database (created by docker/init). They reset it on every run.
TEST_DATABASE_URL=postgresql://zetra_app:zetra_app@localhost:5432/zetra_test
TEST_MIGRATION_DATABASE_URL=postgresql://zetra:zetra@localhost:5432/zetra_test
DB_POOL_SIZE=10

# ───────────────────────────── Secrets ─────────────────────────────
# Required in production. Generate with: openssl rand -base64 48
# These placeholders are replaced with random values by setup:local. Set your own before hosting.
SESSION_SECRET=replace-with-random-session-secret
# AES-256-GCM key for webhook signing secrets. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters
# Hosting only: generate a strong password for the restricted zetra_app PostgreSQL role.
APP_DB_PASSWORD=

# ───────────────────────────── NEAR ─────────────────────────────
# Select a finalized start height immediately before enabling a network.
NEAR_MAINNET_ENABLED=false
NEAR_MAINNET_START_HEIGHT=
NEAR_MAINNET_RPC_URL=https://rpc.mainnet.near.org
NEAR_MAINNET_DATA_URL=https://mainnet.neardata.xyz
NEAR_MAINNET_USDC_CONTRACT_ID=
NEAR_TESTNET_ENABLED=false
NEAR_TESTNET_START_HEIGHT=
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
NEAR_TESTNET_DATA_URL=https://testnet.neardata.xyz
# Optional for higher FastNear request quotas.
# FASTNEAR_API_KEY=
# Ref Finance's test-only bridged USDC contract. It has no real-world value.
NEAR_TESTNET_USDC_CONTRACT_ID=usdc.fakes.testnet

# ───────────────────────────── Worker ─────────────────────────────
WORKER_POLL_MS=1000
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_TIMEOUT_MS=10000
# Allow webhook URLs on localhost/private networks. Defaults to true outside production.
WEBHOOK_ALLOW_PRIVATE_URLS=

# ───────────────────────────── API ─────────────────────────────
RATE_LIMIT_PER_MINUTE=300
# Proxy hops allowed to set X-Forwarded-For (proxy-addr syntax, or true/false). The default trusts only
# private/loopback peers such as the Next.js proxy, so clients can't spoof their IP to dodge rate limits.
TRUST_PROXY=loopback,linklocal,uniquelocal
AUTH_RATE_LIMIT_PER_MINUTE=20

# ───────────────────────────── Email (optional) ─────────────────────────────
# Without SMTP, password-reset and invitation links are written to the API log (development only).
SMTP_URL=
EMAIL_FROM=Zetra <no-reply@example.com>

# ── Stripe processor (optional live connector) ────────────────────────────────────────────────
# Keep these only in the runtime secret manager. Stripe sends signed events to
# /api/v1/inbound/payment-sources/:id/stripe. Zetra stores receipt evidence, never card data.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Outgoing NEAR signer (optional; never commit these) ───────────────────────────────────────
# The worker reads these only when processing an approved payout. Use a dedicated hot wallet
# with a strictly limited balance and permissions; do not paste keys into the app or API.
NEAR_TESTNET_PAYOUT_SIGNER_ID=
NEAR_TESTNET_PAYOUT_PRIVATE_KEY=
NEAR_MAINNET_PAYOUT_SIGNER_ID=
NEAR_MAINNET_PAYOUT_PRIVATE_KEY=
# Optional fallback valuation for gas. Prefer a dated NEAR/USD fx_rates row in the books.
NEAR_FEE_USD_RATE=
# Optional deployment target for the native books-attestation contract (not a secret).
ZETRA_ATTESTATION_ACCOUNT=
ZETRA_ATTESTATION_CONTRACT_ID=
ZETRA_ATTESTATION_SIGNER_ID=
ZETRA_ATTESTATION_PRIVATE_KEY=

# ── Optional integrations ───────────────────────────────────────────────────────────────────────
# Optional language model for Zeti (any OpenAI-compatible API; Groq's free tier by default).
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
